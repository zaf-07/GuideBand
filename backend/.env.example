# Copy to backend/.env and fill in. backend/.env is git-ignored.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional fallback provider, tried when Gemini fails.
# GROQ_API_KEY=
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Order in which cloud providers are tried.
# VISION_PROVIDERS=gemini,groq

# Local detector.
# YOLO_ENABLED=true
# YOLO_MODEL=backend/models/yolo11n.pt
# YOLO_DEVICE=cuda:0
# YOLO_MIN_CONFIDENCE=0.35

# Payments: only Stripe test keys (sk_test_... or rk_test_...) are accepted. Empty = simulated.
# STRIPE_SECRET_KEY=

# Natural voice (optional). Without it the browser voice is used.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# WhatsApp delivery without a manual Send tap (optional, Twilio).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886

# Windows only, opt-in: press Send in WhatsApp Desktop on this computer after a spoken yes.
# WHATSAPP_DESKTOP_SEND=true
# WHATSAPP_SEND_DELAY_MS=4000

# Speech-to-text for a chosen microphone such as the Vexo bracelet (Deepgram Nova-3).
# DEEPGRAM_API_KEY=
