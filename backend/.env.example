# Copy to backend/.env and fill in. backend/.env is git-ignored.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional fallback provider, tried when Gemini fails.
# GROQ_API_KEY=
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Order in which cloud providers are tried.
# VISION_PROVIDERS=gemini,groq

# Local detector.
# YOLO_ENABLED=true
# YOLO_MODEL=backend/models/yolo11n.pt
# YOLO_DEVICE=cuda:0
# YOLO_MIN_CONFIDENCE=0.35

# Payments: only Stripe test keys (sk_test_...) are accepted. Empty = simulated.
# STRIPE_SECRET_KEY=

# Natural voice (optional). Without it the browser voice is used.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
